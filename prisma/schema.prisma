// botbrix.com — PostgreSQL schema (Prisma)
// Normalized AI-model registry + provider/endpoint DB + benchmark/scoring engine
// + admin/audit + user/API monetization. See README for the phased build plan.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum ModelStatus {
  active
  preview
  beta
  experimental
  deprecated
  possibly_unavailable
  inactive
}

enum Category {
  chat
  reasoning
  coding
  multimodal
  local
  embedding
  reranker
}

enum Openness {
  closed
  open_weight
  open_source
}

enum AvailabilityStatus {
  available
  limited
  possibly_unavailable
  offline
}

enum SourceType {
  provider_api
  provider_docs
  marketplace
  benchmark
  huggingface
  news
  llm_enrichment
  manual
}

enum ReliabilityLevel {
  official
  marketplace
  benchmark
  community
  estimated
}

enum ChangeType {
  create
  update
  delete
  price_change
  status_change
  provider_change
  benchmark_change
}

enum UserRole {
  free
  pro
  developer
  admin
}

enum PlanTier {
  free
  pro
  developer
}

enum SubscriptionStatus {
  active
  trialing
  past_due
  canceled
  incomplete
}

enum ReportStatus {
  open
  reviewing
  resolved
  rejected
}

// ---------------------------------------------------------------------------
// Core registry
// ---------------------------------------------------------------------------

model Lab {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  websiteUrl  String?
  country     String?
  logoUrl     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  models Model[]
}

model Model {
  id                    String      @id @default(cuid())
  slug                  String      @unique
  name                  String
  family                String?
  labId                 String?
  status                ModelStatus @default(active)
  category              Category    @default(chat)

  releaseDate           DateTime?
  knowledgeCutoff       DateTime?

  openness              Openness    @default(closed)
  isOpenSource          Boolean     @default(false)
  isOpenWeight          Boolean     @default(false)
  license               String?
  parameterCount        String? // e.g. "70B", "MoE 8x22B", nullable when unknown

  contextWindow         Int?
  maxOutputTokens       Int?
  inputModalities       String[]    @default([])
  outputModalities      String[]    @default([])

  // Feature flags
  supportsTools         Boolean     @default(false)
  supportsFunctionCall  Boolean     @default(false)
  supportsJsonMode      Boolean     @default(false)
  supportsStructured    Boolean     @default(false)
  supportsVision        Boolean     @default(false)
  supportsAudio         Boolean     @default(false)
  supportsReasoning     Boolean     @default(false)
  supportsCoding        Boolean     @default(false)
  supportsStreaming     Boolean     @default(false)
  supportsBatch         Boolean     @default(false)

  // Local deployment
  supportsLocal         Boolean     @default(false)
  localRuntimes         String[]    @default([]) // ollama, lmstudio, vllm, llamacpp
  hardwareRequirements  String?

  // Lifecycle badges
  isPreview             Boolean     @default(false)
  isBeta                Boolean     @default(false)
  isExperimental        Boolean     @default(false)
  isNew                 Boolean     @default(false)
  isAutoDetected        Boolean     @default(false)
  isVerified            Boolean     @default(false)
  isHidden              Boolean     @default(false)

  lastCheckedAt         DateTime?
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  lab            Lab?                    @relation(fields: [labId], references: [id])
  descriptions   ModelDescription[]
  endpoints      ProviderEndpoint[]
  scores         Score[]
  benchmarks     ModelBenchmarkResult[]
  sources        ModelSource[]
  favorites      UserFavorite[]
  watchlists     UserWatchlist[]
  reports        DataReport[]

  @@index([category])
  @@index([status])
  @@index([labId])
}

model ModelDescription {
  id         String   @id @default(cuid())
  modelId    String
  locale     String // "en" | "de"
  short      String   @db.Text
  long       String?  @db.Text
  strengths  String[] @default([])
  weaknesses String[] @default([])
  useCases   String[] @default([])
  isAiGenerated Boolean @default(true)
  isReviewed    Boolean @default(false)
  updatedAt  DateTime @updatedAt

  model Model @relation(fields: [modelId], references: [id], onDelete: Cascade)

  @@unique([modelId, locale])
}

model Provider {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  websiteUrl  String?
  region      String?
  euHosting   Boolean  @default(false)
  logoUrl     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  endpoints ProviderEndpoint[]
}

model ProviderEndpoint {
  id                   String             @id @default(cuid())
  modelId              String
  providerId           String
  apiModelId           String?
  endpointUrl          String?
  availabilityStatus   AvailabilityStatus @default(available)
  region               String?

  inputPricePer1m      Decimal?           @db.Decimal(12, 4)
  outputPricePer1m     Decimal?           @db.Decimal(12, 4)
  cachedInputPricePer1m Decimal?          @db.Decimal(12, 4)
  priceCurrency        String             @default("USD")

  contextWindowOverride Int?
  maxOutputTokensOverride Int?
  outputSpeedTps       Float?
  timeToFirstTokenMs   Int?
  uptime30m            Float?

  sourceId             String?
  lastCheckedAt        DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  model    Model    @relation(fields: [modelId], references: [id], onDelete: Cascade)
  provider Provider @relation(fields: [providerId], references: [id])
  source   Source?  @relation(fields: [sourceId], references: [id])

  @@unique([modelId, providerId, apiModelId])
  @@index([providerId])
}

// ---------------------------------------------------------------------------
// Scoring
// ---------------------------------------------------------------------------

model Score {
  id                   String   @id @default(cuid())
  modelId              String
  overall              Float
  coding               Float
  frontendCoding       Float
  backendCoding        Float
  math                 Float
  reasoning            Float
  writing              Float
  german               Float
  translation          Float
  business             Float
  cheapApi             Float
  speed                Float
  privacyEu            Float
  local                Float
  openWeight           Float
  rag                  Float
  longContext          Float
  agentTool            Float
  vision               Float
  dataAnalysis         Float
  customerSupport      Float
  legalDrafting        Float
  salesEmail           Float
  pricePerformance     Float
  scoreVersion         String
  isEstimated          Boolean  @default(false)
  calculatedAt         DateTime @default(now())

  model Model @relation(fields: [modelId], references: [id], onDelete: Cascade)

  @@index([modelId])
}

// ---------------------------------------------------------------------------
// Benchmarks
// ---------------------------------------------------------------------------

model BenchmarkGroup {
  id         String      @id @default(cuid())
  slug       String      @unique
  name       String
  description String?
  benchmarks Benchmark[]
}

model Benchmark {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  groupId     String?
  description String?
  sourceUrl   String?
  higherIsBetter Boolean @default(true)
  maxValue    Float?

  group   BenchmarkGroup?        @relation(fields: [groupId], references: [id])
  results ModelBenchmarkResult[]
}

model ModelBenchmarkResult {
  id            String   @id @default(cuid())
  modelId       String
  benchmarkId   String
  rawValue      Float?
  normalized    Float? // 0-100
  isEstimated   Boolean  @default(false)
  isDisputed    Boolean  @default(false)
  notes         String?
  sourceId      String?
  lastCheckedAt DateTime?

  model     Model     @relation(fields: [modelId], references: [id], onDelete: Cascade)
  benchmark Benchmark @relation(fields: [benchmarkId], references: [id])
  source    Source?   @relation(fields: [sourceId], references: [id])

  @@unique([modelId, benchmarkId])
}

// ---------------------------------------------------------------------------
// Sources & provenance
// ---------------------------------------------------------------------------

model Source {
  id              String           @id @default(cuid())
  sourceType      SourceType
  name            String
  url             String?
  reliabilityLevel ReliabilityLevel @default(marketplace)
  retrievedAt     DateTime         @default(now())
  rawPayload      Json?

  endpoints    ProviderEndpoint[]
  benchmarks   ModelBenchmarkResult[]
  modelSources ModelSource[]
  changeLogs   ChangeLog[]
}

model ModelSource {
  id       String @id @default(cuid())
  modelId  String
  sourceId String

  model  Model  @relation(fields: [modelId], references: [id], onDelete: Cascade)
  source Source @relation(fields: [sourceId], references: [id])

  @@unique([modelId, sourceId])
}

// ---------------------------------------------------------------------------
// Update pipeline & audit
// ---------------------------------------------------------------------------

model UpdateRun {
  id          String   @id @default(cuid())
  startedAt   DateTime @default(now())
  finishedAt  DateTime?
  status      String   @default("running")
  newModels   Int      @default(0)
  updatedModels Int    @default(0)
  errors      Int      @default(0)
  summary     String?  @db.Text

  importLogs ImportLog[]
  changeLogs ChangeLog[]
}

model ImportLog {
  id          String   @id @default(cuid())
  runId       String?
  sourceName  String
  level       String   @default("info") // info | warn | error
  message     String   @db.Text
  createdAt   DateTime @default(now())

  run UpdateRun? @relation(fields: [runId], references: [id])
}

model ChangeLog {
  id          String     @id @default(cuid())
  runId       String?
  entityType  String // model | endpoint | price | benchmark | score
  entityId    String
  fieldName   String?
  oldValue    String?    @db.Text
  newValue    String?    @db.Text
  changeType  ChangeType
  sourceId    String?
  changedBy   String? // "system" | admin user id
  createdAt   DateTime   @default(now())

  run    UpdateRun? @relation(fields: [runId], references: [id])
  source Source?    @relation(fields: [sourceId], references: [id])

  @@index([entityType, entityId])
}

model AdminAuditLog {
  id        String   @id @default(cuid())
  adminId   String
  action    String
  entityType String
  entityId  String?
  before    Json?
  after     Json?
  createdAt DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Content & monetization
// ---------------------------------------------------------------------------

model NewsItem {
  id          String   @id @default(cuid())
  slug        String   @unique
  titleEn     String
  titleDe     String?
  bodyEn      String   @db.Text
  bodyDe      String?  @db.Text
  kind        String // new_model | price_change | benchmark | provider
  publishedAt DateTime @default(now())
}

model DailySummary {
  id          String   @id @default(cuid())
  date        DateTime @unique
  summaryEn   String   @db.Text
  summaryDe   String?  @db.Text
  createdAt   DateTime @default(now())
}

model FeaturedSlot {
  id          String   @id @default(cuid())
  placement   String // homepage_hero | table_top | sidebar
  label       String   @default("Sponsored")
  modelId     String?
  targetUrl   String
  isActive    Boolean  @default(true)
  startsAt    DateTime?
  endsAt      DateTime?
  createdAt   DateTime @default(now())
}

model Lead {
  id        String   @id @default(cuid())
  name      String?
  email     String
  company   String?
  message   String?  @db.Text
  source    String?
  createdAt DateTime @default(now())
}

model NewsletterSignup {
  id        String   @id @default(cuid())
  email     String   @unique
  locale    String   @default("en")
  confirmed Boolean  @default(false)
  createdAt DateTime @default(now())
}

model DataReport {
  id          String       @id @default(cuid())
  modelId     String?
  field       String?
  message     String       @db.Text
  reporterEmail String?
  status      ReportStatus @default(open)
  createdAt   DateTime     @default(now())

  model Model? @relation(fields: [modelId], references: [id])
}

// ---------------------------------------------------------------------------
// Users, auth, subscriptions, API
// ---------------------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  image         String?
  role          UserRole  @default(free)
  passwordHash  String?
  emailVerified DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts     Account[]
  sessions     Session[]
  subscription Subscription?
  apiKeys      ApiKey[]
  favorites    UserFavorite[]
  watchlists   UserWatchlist[]
  csvExports   CsvExport[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Subscription {
  id                 String             @id @default(cuid())
  userId             String             @unique
  tier               PlanTier           @default(free)
  status             SubscriptionStatus @default(active)
  stripeCustomerId   String?
  stripeSubscriptionId String?
  currentPeriodEnd   DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ApiKey {
  id          String   @id @default(cuid())
  userId      String
  name        String
  keyPrefix   String
  keyHash     String   @unique
  isActive    Boolean  @default(true)
  monthlyQuota Int     @default(10000)
  createdAt   DateTime @default(now())
  lastUsedAt  DateTime?
  revokedAt   DateTime?

  user  User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  usage ApiUsage[]

  @@index([userId])
}

model ApiUsage {
  id        String   @id @default(cuid())
  apiKeyId  String
  endpoint  String
  status    Int
  createdAt DateTime @default(now())

  apiKey ApiKey @relation(fields: [apiKeyId], references: [id], onDelete: Cascade)

  @@index([apiKeyId, createdAt])
}

model UserFavorite {
  id      String @id @default(cuid())
  userId  String
  modelId String

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  model Model @relation(fields: [modelId], references: [id], onDelete: Cascade)

  @@unique([userId, modelId])
}

model UserWatchlist {
  id      String @id @default(cuid())
  userId  String
  modelId String
  note    String?

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  model Model @relation(fields: [modelId], references: [id], onDelete: Cascade)

  @@unique([userId, modelId])
}

model CsvExport {
  id        String   @id @default(cuid())
  userId    String
  kind      String
  rowCount  Int      @default(0)
  filters   Json?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
