# ---------------------------------------------------------------------------
# botbrix.com — environment configuration
# Copy to .env and fill in. The app RUNS WITHOUT A DATABASE using the committed
# real-data snapshot (src/data/models.snapshot.json). A DATABASE_URL is only
# required for the full DB-backed pipeline (import + admin + scoring persistence).
# ---------------------------------------------------------------------------

# --- Core ---
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Database (PostgreSQL, e.g. Supabase / Neon / local) ---
# Optional for the read-only demo; required for importers, admin, auth.
DATABASE_URL="postgresql://user:password@localhost:5432/botbrix?schema=public"

# --- Admin backend (Phase 5) ---
# Self-contained admin login (independent of end-user auth). Editing (overrides,
# featured slots, reports) also needs DATABASE_URL; login works without it.
ADMIN_EMAIL="admin@botbrix.com"
ADMIN_PASSWORD="change-me"
# Optional: secret used to sign the admin session cookie. Falls back to a value
# derived from ADMIN_PASSWORD if unset. Set a long random string in production.
ADMIN_SESSION_SECRET=""

# --- Auth (Phase 6) ---
# NextAuth / Auth.js
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Data source API keys (importers) ---
# OpenRouter public models endpoint needs NO key. A key raises rate limits.
OPENROUTER_API_KEY=""
# Artificial Analysis (benchmarks) — optional, Phase 4
ARTIFICIAL_ANALYSIS_API_KEY=""
# Hugging Face Hub — optional, raises rate limits
HUGGINGFACE_API_TOKEN=""

# --- LLM enrichment (daily agent, Phase 2) ---
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""

# --- Payments (Phase 6, non-blocking) ---
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# --- Rate limiting (Phase 7) ---
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# --- Jobs / cron ---
# Secret used to authorize the daily update cron endpoint.
CRON_SECRET=""
# Timezone for the daily update agent.
UPDATE_TZ="Europe/Vienna"
